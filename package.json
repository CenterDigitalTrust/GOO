{
    "name": "nmd1-hackathon",
    "version": "0.1.0",
    "private": true,
    "description": "NMD1 hackathon Electron React desktop prompt workspace",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
        "build": "tsc --noEmit && vite build",
        "start": "electron .",
        "dist:win": "npm run build && electron-builder --win portable",
        "preview": "vite preview"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@supabase/supabase-js": "^2.110.8",
        "@vitejs/plugin-react": "^4.3.4",
        "ffmpeg-static": "^5.3.0",
        "fluent-ffmpeg": "^2.1.3",
        "framer-motion": "^12.42.2",
        "google-auth-library": "^11.0.2",
        "lucide-react": "^1.26.0",
        "node-fetch": "^3.3.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vite": "^6.0.7",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.4",
        "@types/react-dom": "^19.0.2",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "electron": "^33.4.11",
        "electron-builder": "^25.1.8",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "wait-on": "^8.0.1"
    },
    "build": {
        "appId": "com.miracledroplet.nmd1",
        "productName": "NMD1 Hackathon",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "config.json",
                "to": "config.json"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "NMD1-Hackathon.exe",
            "signAndEditExecutable": false
        },
        "portable": {
            "artifactName": "NMD1-Hackathon.exe"
        },
        "asar": true,
        "compression": "normal",
        "npmRebuild": false
    }
}
